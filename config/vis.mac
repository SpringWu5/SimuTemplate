# Macro file for the visualization settings - Enhanced version

# Open OpenGL view
/vis/ogl/set/displayListLimit 10000000
/vis/open OGL 800x800-0+0

# Disable auto refresh while setting up
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Initialize the run
/run/initialize

# Draw geometry
/vis/drawVolume

# Set view angle
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/lightsVector -1 0 0

# Use surface style without wireframes
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge false
/vis/viewer/set/edge false

# Store and display all trajectories
/tracking/storeTrajectory 1
/vis/scene/add/trajectories smooth

# 切换到基于粒子ID的轨迹模型
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByParticleID-0/default/setStepPtsSize 2
/vis/modeling/trajectories/drawByParticleID-0/default/setDrawLine true
/vis/modeling/trajectories/drawByParticleID-0/default/setLineWidth 2

# 设置特定粒子的颜色
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton yellow
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set e- blue
/vis/modeling/trajectories/drawByParticleID-0/set e+ red
/vis/modeling/trajectories/drawByParticleID-0/set mu- magenta
/vis/modeling/trajectories/drawByParticleID-0/set mu+ cyan
/vis/modeling/trajectories/drawByParticleID-0/set neutron white

#/vis/scene/add/trajectories rich
#/vis/modeling/trajectories/rich-0/default/setStepPtsSize 0
#/vis/modeling/trajectories/rich-0/default/setStepPtsPerCircle 4

# Accumulate all events
/vis/scene/endOfEventAction accumulate

# Add scale and axes for reference
/vis/scene/add/scale
/vis/scene/add/axes

# World volume - completely transparent
/vis/geometry/set/visibility World 0
/vis/geometry/set/colour World 1.0 1.0 1.0 0.0
/vis/geometry/set/forceSolid World 1

# Scintillator - 几乎透明的非常浅绿色
/vis/geometry/set/visibility Scint 1
/vis/geometry/set/colour Scint 0.9 1.0 0.9 0.05
/vis/geometry/set/forceSolid Scint 1

# ESR - red tinted transparent
/vis/geometry/set/visibility ESR 1
/vis/geometry/set/colour ESR 1.0 0.5 0.5 0.1
/vis/geometry/set/forceSolid ESR 1

# Tape - yellow tinted transparent
/vis/geometry/set/visibility Tape 1
/vis/geometry/set/colour Tape 1.0 1.0 0.5 0.1
/vis/geometry/set/forceSolid Tape 1

# SiPM - solid blue
/vis/geometry/set/visibility SiPM 1
/vis/geometry/set/colour SiPM 0.0 0.0 1.0 1.0
/vis/geometry/set/forceSolid SiPM 1

# Battery - dark gray
/vis/geometry/set/visibility Battery 1
/vis/geometry/set/colour Battery 0.3 0.3 0.3 0.8
/vis/geometry/set/forceSolid Battery 1

# Turn on hits display
/vis/scene/add/hits

# 其他设置
/run/verbose 2
/event/verbose 1

# Set a nice viewpoint and zoom
/vis/viewer/set/viewpointThetaPhi 90 90
/vis/viewer/zoom 1.5

# Re-establish auto refreshing and render
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
/vis/viewer/flush