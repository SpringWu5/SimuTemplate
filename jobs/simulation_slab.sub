# ==============================================================================
# simulation_slab.sub
# ------------------------------------------------------------------------------
# HTCondor smoke-test job for the MuonSLab detector.
# Runs 2 aimed muons and writes output_slab.root.
# Submit: condor_submit jobs/simulation_slab.sub
# ==============================================================================
PROJECT_ROOT = /lustre/YOUR_GROUP/YOUR_USERNAME/simu_template

Universe   = vanilla
Executable = $(PROJECT_ROOT)/jobs/run_simulation_wrapper.sh

Arguments  = $(PROJECT_ROOT)/config/config_muonslab.yaml \
             $(PROJECT_ROOT)/build/output_slab.root

Log        = $(PROJECT_ROOT)/jobs/logs/slab_$(ClusterId).log
Output     = $(PROJECT_ROOT)/jobs/logs/slab_$(ClusterId).out
Error      = $(PROJECT_ROOT)/jobs/logs/slab_$(ClusterId).err

request_cpus = 1
should_transfer_files = NO
getenv = True

Queue
