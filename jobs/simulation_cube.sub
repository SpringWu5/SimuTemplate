# ==============================================================================
# simulation_cube.sub
# ------------------------------------------------------------------------------
# HTCondor smoke-test job for the MuonCube detector.
# Runs 2 aimed muons and writes output_cube.root.
# Submit: condor_submit jobs/simulation_cube.sub
# ==============================================================================
PROJECT_ROOT = /lustre/YOUR_GROUP/YOUR_USERNAME/simu_template

Universe   = vanilla
Executable = $(PROJECT_ROOT)/jobs/run_simulation_wrapper.sh

Arguments  = $(PROJECT_ROOT)/config/config_muoncube.yaml \
             $(PROJECT_ROOT)/build/output_cube.root

Log        = $(PROJECT_ROOT)/jobs/logs/cube_$(ClusterId).log
Output     = $(PROJECT_ROOT)/jobs/logs/cube_$(ClusterId).out
Error      = $(PROJECT_ROOT)/jobs/logs/cube_$(ClusterId).err

request_cpus = 1
should_transfer_files = NO
getenv = True

Queue
